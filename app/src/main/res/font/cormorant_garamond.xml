<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/cormorant_garamond_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/cormorant_garamond_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/cormorant_garamond_italic"
        android:fontStyle="italic"
        android:fontWeight="400"
        app:font="@font/cormorant_garamond_italic"
        app:fontStyle="italic"
        app:fontWeight="400" />

    <font
        android:font="@font/cormorant_garamond_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/cormorant_garamond_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/cormorant_garamond_medium_italic"
        android:fontStyle="italic"
        android:fontWeight="500"
        app:font="@font/cormorant_garamond_medium_italic"
        app:fontStyle="italic"
        app:fontWeight="500" />

    <font
        android:font="@font/cormorant_garamond_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/cormorant_garamond_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/cormorant_garamond_semibold_italic"
        android:fontStyle="italic"
        android:fontWeight="600"
        app:font="@font/cormorant_garamond_semibold_italic"
        app:fontStyle="italic"
        app:fontWeight="600" />

    <font
        android:font="@font/cormorant_garamond_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/cormorant_garamond_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

    <font
        android:font="@font/cormorant_garamond_bold_italic"
        android:fontStyle="italic"
        android:fontWeight="700"
        app:font="@font/cormorant_garamond_bold_italic"
        app:fontStyle="italic"
        app:fontWeight="700" />

    <font
        android:font="@font/cormorant_garamond_light"
        android:fontStyle="normal"
        android:fontWeight="300"
        app:font="@font/cormorant_garamond_light"
        app:fontStyle="normal"
        app:fontWeight="300" />

    <font
        android:font="@font/cormorant_garamond_light_italic"
        android:fontStyle="italic"
        android:fontWeight="300"
        app:font="@font/cormorant_garamond_light_italic"
        app:fontStyle="italic"
        app:fontWeight="300" />

</font-family>