<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="Theme.LumiAlpha" parent="Theme.MaterialComponents.Light.NoActionBar">

        <!-- Brand colors -->
        <item name="colorPrimary">#7A6652</item>
        <item name="colorPrimaryVariant">#5C4D3C</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">#C8B89A</item>
        <item name="colorSecondaryVariant">#A89880</item>
        <item name="colorOnSecondary">#2C1810</item>

        <!-- Backgrounds -->
        <item name="android:colorBackground">#F5F0EB</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnBackground">#2C1810</item>
        <item name="colorOnSurface">#2C1810</item>

        <!-- Error -->
        <item name="colorError">#B00020</item>
        <item name="colorOnError">#FFFFFF</item>

        <!-- Status bar matches cream background -->
        <item name="android:statusBarColor">#F5F0EB</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">#F5F0EB</item>

        <!-- Window background -->
        <item name="android:windowBackground">#F5F0EB</item>

        <!-- Page transition animations -->
        <item name="android:windowActivityTransitions">true</item>

        <!-- TextInputLayout outline color -->
        <item name="colorControlActivated">#7A6652</item>
        <item name="colorControlHighlight">#C8B89A</item>

    </style>

    <!-- Oval shape for collection thumbnails -->
    <style name="OvalShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Dialog style -->
    <style name="LumiDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">#7A6652</item>
        <item name="android:colorBackground">#F5F0EB</item>
        <item name="colorOnSurface">#2C1810</item>
    </style>

    <!-- Splash screen theme (no action bar, cream bg) -->
    <style name="Theme.LumiAlpha.Splash" parent="Theme.LumiAlpha">
        <item name="android:windowBackground">#F5F0EB</item>
    </style>

    <!-- Login theme -->
    <style name="Theme.LumiAlpha.Login" parent="Theme.LumiAlpha">
        <item name="android:windowBackground">#F5F0EB</item>
    </style>

</resources>