<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0EB">

    <!-- Top bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F0EB"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#2C1810"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Details"
                android:textSize="16sp"
                android:fontFamily="@font/cormorant_garamond"
                android:textStyle="bold"
                android:textColor="#2C1810"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/cartIconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_cart"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#2C1810"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero image with dots indicator -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/productDetailImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <!-- Dot indicators (static, 4 dots) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <View android:layout_width="8dp" android:layout_height="8dp"
                        android:layout_margin="3dp" android:background="@drawable/dot_active" />
                    <View android:layout_width="8dp" android:layout_height="8dp"
                        android:layout_margin="3dp" android:background="@drawable/dot_inactive" />
                    <View android:layout_width="8dp" android:layout_height="8dp"
                        android:layout_margin="3dp" android:background="@drawable/dot_inactive" />
                    <View android:layout_width="8dp" android:layout_height="8dp"
                        android:layout_margin="3dp" android:background="@drawable/dot_inactive" />

                </LinearLayout>
            </FrameLayout>

            <!-- Thumbnail row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:id="@+id/thumb1"
                    android:layout_width="64dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/thumb_selected" />

                <ImageView
                    android:id="@+id/thumb2"
                    android:layout_width="64dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/thumb_unselected" />

                <ImageView
                    android:id="@+id/thumb3"
                    android:layout_width="64dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/thumb_unselected" />

                <ImageView
                    android:id="@+id/thumb4"
                    android:layout_width="64dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/thumb_unselected" />

            </LinearLayout>

            <!-- Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- Product name -->
                <TextView
                    android:id="@+id/productDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:fontFamily="@font/cormorant_garamond"
                    android:textStyle="bold"
                    android:textColor="#2C1810"
                    android:layout_marginBottom="12dp" />

                <!-- Rent / Buy toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:background="@drawable/toggle_background"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/toggleRent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Rent"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/toggle_active"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/toggleBuy"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Buy"
                        android:textColor="#7A6652"
                        android:background="@android:color/transparent"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Price -->
                <TextView
                    android:id="@+id/productDetailPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:fontFamily="@font/cormorant_garamond"
                    android:textStyle="bold"
                    android:textColor="#7A6652"
                    android:layout_marginBottom="6dp" />

                <!-- Description -->
                <TextView
                    android:id="@+id/productDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#7A6652"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="20dp" />

                <!-- Select Size label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Size"
                    android:textSize="13sp"
                    android:textColor="#2C1810"
                    android:fontFamily="@font/cormorant_garamond"
                    android:layout_marginBottom="10dp" />

                <!-- Size chips row -->
                <LinearLayout
                    android:id="@+id/sizeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp" />

                <!-- Rental Period -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rental Period"
                    android:textSize="13sp"
                    android:textColor="#2C1810"
                    android:fontFamily="@font/cormorant_garamond"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Rent Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rent Date"
                    android:textSize="12sp"
                    android:textColor="#2C1810"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/rentDateLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:startIconDrawable="@drawable/ic_calendar"
                    app:boxBackgroundColor="#F5F0EB"
                    app:boxStrokeColor="#C8B89A"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/rentDateField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="mm/dd/yyyy"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Return Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Return Date (Max 7 days)"
                    android:textSize="12sp"
                    android:textColor="#2C1810"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/returnDateLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:startIconDrawable="@drawable/ic_calendar"
                    app:boxBackgroundColor="#F5F0EB"
                    app:boxStrokeColor="#C8B89A"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/returnDateField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="mm/dd/yyyy"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Extended rental checkbox -->
                <CheckBox
                    android:id="@+id/extendedRentalCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="I need extended rental (more than 7 days)"
                    android:textSize="13sp"
                    android:textColor="#7A6652"
                    android:buttonTint="#7A6652"
                    android:layout_marginBottom="24dp" />

                <!-- Wishlist -->
                <ImageButton
                    android:id="@+id/wishlistButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_heart_outline"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#7A6652"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <!-- Try On with AR button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previewButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="✦  Try On with AR"
                    android:textSize="15sp"
                    app:backgroundTint="#7A6652"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="10dp" />

                <!-- Add to Cart -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addToCartButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Add to Cart"
                    android:textSize="14sp"
                    app:strokeColor="#7A6652"
                    android:textColor="#7A6652"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#F5F0EB"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="#2C1810"
        app:itemTextColor="#2C1810"
        app:labelVisibilityMode="labeled"
        app:elevation="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>