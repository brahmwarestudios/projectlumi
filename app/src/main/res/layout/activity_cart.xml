<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0EB">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F0EB"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Cart"
                android:textSize="22sp"
                android:fontFamily="@font/cormorant_garamond"
                android:textStyle="bold"
                android:textColor="#2C1810"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Item count badge -->
            <TextView
                android:id="@+id/cartItemCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 items"
                android:textSize="12sp"
                android:textColor="#9E8E85"
                android:fontFamily="@font/cormorant_garamond"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0D5C8" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Improved empty state -->
        <LinearLayout
            android:id="@+id/cartEmptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="32dp">

            <!-- Decorative circle background -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/empty_state_circle"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:src="@drawable/baseline_shopping_cart_24"
                    android:alpha="0.5"
                    app:tint="#7A6652" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your cart is empty"
                android:textSize="20sp"
                android:fontFamily="@font/cormorant_garamond"
                android:textStyle="bold"
                android:textColor="#2C1810"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discover gowns and accessories to rent for your next event."
                android:textSize="13sp"
                android:textColor="#9E8E85"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueShoppingBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Browse Collection"
                android:textSize="13sp"
                android:paddingHorizontal="28dp"
                app:backgroundTint="#7A6652"
                android:textColor="#FFFFFF"
                app:cornerRadius="24dp" />

        </LinearLayout>

        <!-- Cart content -->
        <LinearLayout
            android:id="@+id/cartContentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cartRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp"
                android:clipToPadding="false" />

            <!-- Footer with top divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F0EB">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0D5C8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Order total row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:textColor="#9E8E85"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/cartTotalText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0"
                            android:textColor="#2C1810"
                            android:textSize="22sp"
                            android:fontFamily="@font/cormorant_garamond"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery and fees calculated at checkout"
                        android:textSize="11sp"
                        android:textColor="#C8B89A"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/checkoutButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Proceed to Checkout"
                        android:textSize="15sp"
                        android:textAllCaps="false"
                        android:letterSpacing="0.02"
                        app:cornerRadius="26dp"
                        app:backgroundTint="#7A6652"
                        android:textColor="#FFFFFF" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavCart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#F5F0EB"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="#2C1810"
        app:itemTextColor="#2C1810"
        app:labelVisibilityMode="labeled"
        app:elevation="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>