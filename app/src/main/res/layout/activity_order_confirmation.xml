<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/lumi_background">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/lumi_primary"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Booking Confirmed!"
        android:textSize="26sp"
        android:textColor="@color/lumi_on_surface"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/confirmName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/lumi_on_surface_variant"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/confirmDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/lumi_primary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/confirmAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/lumi_on_surface_variant"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="We'll contact you to confirm pick-up details."
        android:textSize="12sp"
        android:textColor="@color/lumi_on_surface_variant"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/continueShopping"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Browse More Items"
        android:textSize="15sp"
        app:backgroundTint="@color/lumi_primary"
        android:textColor="@color/lumi_on_primary"
        app:cornerRadius="26dp" />

</LinearLayout>
