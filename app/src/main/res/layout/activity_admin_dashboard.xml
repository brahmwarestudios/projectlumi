<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0EB"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lumi"
        android:textSize="40sp"
        android:fontFamily="@font/great_vibes"
        android:textColor="#2C1810"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Dashboard"
        android:textSize="14sp"
        android:letterSpacing="0.15"
        android:textColor="#9E8E85"
        android:layout_marginBottom="40dp" />

    <TextView
        android:id="@+id/adminWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:fontFamily="@font/cormorant_garamond"
        android:textStyle="bold"
        android:textColor="#2C1810"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full admin panel coming in Phase 2"
        android:textSize="13sp"
        android:textColor="#9E8E85"
        android:layout_marginBottom="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/adminLogoutButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Log Out"
        android:textSize="15sp"
        android:textColor="#7A6652"
        app:strokeColor="#7A6652"
        app:cornerRadius="8dp" />

</LinearLayout>